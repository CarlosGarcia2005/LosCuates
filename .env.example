# =====================================================
#  Copia este archivo como .env y llena tus datos
# =====================================================
PORT=3000

# ---------- SQL Server / Azure SQL ----------
# Azure SQL:              DB_HOST=tuservidor.database.windows.net  DB_PORT=1433  DB_CIFRADO=1
# SQL Server en tu PC:    DB_HOST=localhost  DB_PORT=1433  DB_CIFRADO=0
# Instancia con nombre:   DB_HOST=LAPTOP-XXXX\SQLEXPRESS  (o DB_INSTANCIA=SQLEXPRESS)
DB_HOST=tuservidor.database.windows.net
DB_PORT=1433
DB_USER=rancho_app
DB_PASSWORD=CambiaEstaClave_2026!
DB_NAME=GestorDeportivoRanchoSeco
DB_INSTANCIA=
# 1 = conexión cifrada (obligatorio en Azure SQL) | 0 = SQL Server local
DB_CIFRADO=1

# ---------- Seguridad ----------
# Genera las dos con:  npm run generar-claves   y pega aquí el resultado
JWT_SECRET=
MFA_CLAVE=

# development en tu PC | production en Vercel (con HTTPS)
NODE_ENV=development
# Pon 1 solo si el servidor está detrás de un proxy (en Vercel va en 1)
TRUST_PROXY=0

# [OWASP A10] Opcional: dominios desde los que se pueden descargar comprobantes
# (vacío = cualquier dominio público; las direcciones internas SIEMPRE se bloquean)
# SSRF_DOMINIOS=drive.google.com,dropbox.com
